# AWS Configuration
AWS_REGION=us-east-1

# SQS Configuration
SQS_VISIBILITY_TIMEOUT=600
SQS_MAX_RECEIVE_COUNT=3
SQS_BATCH_SIZE=1
SQS_WAIT_SECONDS=20

# S3 Configuration
S3_BUCKET_NAME=your-rag-documents-bucket
S3_PREFIX_FILTER=documents/

# SQS Queue URLs (get from AWS Console)
SQS_QUEUE_URL=https://sqs.region.amazonaws.com/account-id/queue-name
SQS_DLQ_URL=https://sqs.region.amazonaws.com/account-id/dlq-name

# OpenSearch Configuration
OPENSEARCH_HOST=https://your-opensearch-domain.region.es.amazonaws.com
OPENSEARCH_INDEX_NAME=rag-vector-index
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=your-secure-password
USE_AWS_OPENSEARCH=False

# Bedrock Configuration
BEDROCK_REGION=us-east-1
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_LLM_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# Worker Configuration
WORKER_CONCURRENCY=1
